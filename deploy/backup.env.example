# Copy to /etc/rsvp-backup.env with root ownership and mode 0600.
# Restic over SFTP to snowblind. The SSH user and key come from /root/.ssh/config
# (see docs/production.md). Initialize the repository once before enabling the timer.
RESTIC_REPOSITORY=sftp:david@snowblind.watsons.family:/snowblind_z3/Backups/DavidBackups/partymail-restic
RESTIC_PASSWORD_FILE=/etc/rsvp-backup.password
RESTIC_CACHE_DIR=/var/lib/rsvp-backup/cache
RSVP_BACKUP_HOST=partymail-production
RSVP_BACKUP_DATA_DIR=/var/lib/rsvp-site
RSVP_BACKUP_APP_ENV=/etc/rsvp-site.env
RSVP_BACKUP_WORK_DIR=/var/lib/rsvp-backup
# Ubuntu 22.04's packaged restic is too old; install a current release binary here.
RSVP_RESTIC_BINARY=/usr/local/bin/restic
