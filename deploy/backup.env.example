# Copy to /etc/rsvp-backup.env with root ownership and mode 0600.
# Choose an off-host bucket/repository; initialize it once before enabling the timer.
RESTIC_REPOSITORY=s3:https://s3.us-west-2.amazonaws.com/REPLACE_BUCKET/partymail
RESTIC_PASSWORD_FILE=/etc/rsvp-backup.password
RESTIC_CACHE_DIR=/var/lib/rsvp-backup/cache
AWS_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_BUCKET_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_BUCKET_SECRET
AWS_DEFAULT_REGION=us-west-2
RSVP_BACKUP_HOST=partymail-production
RSVP_BACKUP_DATA_DIR=/var/lib/rsvp-site
RSVP_BACKUP_APP_ENV=/etc/rsvp-site.env
RSVP_BACKUP_WORK_DIR=/var/lib/rsvp-backup
RSVP_RESTIC_BINARY=/usr/bin/restic
