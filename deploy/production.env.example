# Copy to /etc/rsvp-site.env; keep secrets outside Git and release directories.
RSVP_ENV=production
RSVP_DATA_DIR=/var/lib/rsvp-site
RSVP_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
RSVP_PUBLIC_URL=https://partymail.app
RSVP_WEBAUTHN_RP_ID=partymail.app
RSVP_WEBAUTHN_ORIGIN=https://partymail.app
RSVP_WEBAUTHN_RP_NAME="Party Mail"
# Native iOS association (same Apple Developer team as personal-site).
RSVP_APPLE_TEAM_ID=2FZS79QCFD
# Comma-separated SHA-256 fingerprints of Party Mail's upload/app-signing certs.
# Set after creating the Android signing key / copying the Play App Signing cert.
# This single list controls BOTH Digital Asset Links and WebAuthn native origins.
# Never add the SDK debug certificate to production.
RSVP_ANDROID_SHA256_CERT_FINGERPRINTS=
RSVP_SENDER_EMAIL=you@example.com
RSVP_EMAIL_ENABLED=true
# Required. Shown on /privacy and /terms as the address for questions and removal requests.
RSVP_CONTACT_EMAIL=hello@partymail.app
# The existing guest pages used this property. Verify ownership in Analytics.
RSVP_GA_MEASUREMENT_ID=G-52ZJ7PXYEC
# Enable only behind the one trusted nginx proxy documented above.
RSVP_TRUST_PROXY=true
# Optional emergency/bootstrap password. Owner passkeys and access links are preferred.
# RSVP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_BOOTSTRAP_PASSWORD
# Phone pushes: root-owned copy of the notify-service client (see docs/production.md).
PYTHONPATH=/usr/local/lib/notify-service-client
